{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "api",
          "value": "roblox"
        }
      ],
      "destination": "/api/roblox"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "api",
          "value": "news"
        }
      ],
      "destination": "/api/news"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "api",
          "value": "save"
        }
      ],
      "destination": "/api/save"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}